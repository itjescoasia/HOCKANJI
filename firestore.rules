rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'it@jescoasia.vn' ||
        request.auth.token.email == 'nguyenthetrung200126@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /global_kanjiDeck/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }
    match /global_intensiveVocab/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }
    match /global_conversations/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }
    match /global_audio/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // User can read their own document; Admins can read all user documents (to manage roles and accounts)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // User can create their initial profile document
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Admin can update any user's profile and role.
      // A regular user can update their own profile, but cannot elevate their own role.
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      
      allow delete: if isAdmin();
      
      match /{document=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
